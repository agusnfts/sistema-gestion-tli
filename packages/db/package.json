{
  "name": "@tli/db",
  "version": "0.1.0",
  "private": true,
  "description": "Schema Prisma, migraciones, seeds y cliente compartido",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc",
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx src/seed/base.ts",
    "seed:dev": "dotenv -e ../../.env -- tsx src/seed/dev.ts",
    "create-admin": "dotenv -e ../../.env -- tsx src/seed/create-admin.ts",
    "recover-access": "dotenv -e ../../.env -- tsx src/seed/recover-access.ts",
    "test": "echo \"(sin tests unitarios)\""
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.16.2",
    "@tli/shared": "workspace:*"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
