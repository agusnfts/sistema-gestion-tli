// Schema de datos del Sistema de Gestión TLI. Ver docs/data-model.md.
// Fase 1: identidad, sesiones, RBAC, auditoría y catálogos.
// Fase 2: tickets, comentarios, tiempo, actividad, notificaciones y configuración de SLA.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  // Se guarda siempre en minúsculas.
  email               String     @unique
  fullName            String
  passwordHash        String
  mustChangePassword  Boolean    @default(true)
  passwordChangedAt   DateTime?
  status              UserStatus @default(ACTIVE)
  defaultAreaId       String?    @db.Uuid
  defaultWarehouseId  String?    @db.Uuid
  // Secretos TOTP cifrados con AES-256-GCM (MFA_ENCRYPTION_KEY).
  mfaSecretEnc        String?
  mfaPendingSecretEnc String?
  mfaEnabledAt        DateTime?
  // Último time-step TOTP aceptado: impide reutilizar un código (ASVS 2.8.4).
  mfaLastUsedStep     Int?
  failedLoginCount    Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  anonymizedAt        DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  defaultArea      Area?             @relation(fields: [defaultAreaId], references: [id])
  defaultWarehouse Warehouse?        @relation(fields: [defaultWarehouseId], references: [id])
  roles            UserRole[]
  sessions         Session[]
  recoveryCodes    MfaRecoveryCode[]
  auditEntries     AuditLog[]
  requestedTickets Ticket[]          @relation("TicketRequester")
  assignedTickets  Ticket[]          @relation("TicketAssignee")
  ticketComments   TicketComment[]
  timeEntries      TimeEntry[]
  notifications    Notification[]
  activityEvents   ActivityEvent[]
  attachments      Attachment[]
  ownedProblems    Problem[]         @relation("ProblemOwner")
  createdProblems  Problem[]         @relation("ProblemCreator")

  @@index([status])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  description String           @default("")
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  // Clave estable, ej. "ticket.manage". Se siembra desde @tli/shared.
  key         String           @id
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId        String     @db.Uuid
  permissionKey String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  // SHA-256 del token opaco que viaja en la cookie.
  tokenHash     String    @unique
  userId        String    @db.Uuid
  mfaVerified   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  idleExpiresAt DateTime
  expiresAt     DateTime
  revokedAt     DateTime?
  ip            String?
  userAgent     String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Append-only: un trigger impide UPDATE/DELETE/TRUNCATE. Ver ADR 0008.
model AuditLog {
  seq        BigInt   @id @default(autoincrement())
  occurredAt DateTime @default(now())
  actorId    String?  @db.Uuid
  action     String
  entityType String?
  entityId   String?
  ip         String?
  metadata   Json     @default("{}")
  prevHash   String
  hash       String
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
}

model Area {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  tickets   Ticket[]
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  tickets   Ticket[]
}

model Provider {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Fase 2: ticketera
// ---------------------------------------------------------------------------

enum TicketType {
  SUPPORT
  AUTOMATION
  INTEGRATION
  ACCESS
}

// ACCESS queda solo por tickets históricos: los accesos ahora son un tipo de ticket.
enum TicketCategory {
  WMS
  TMS
  TYT
  ROUTING
  INTEGRATION
  ACCESS
  HARDWARE
  NETWORK
  OTHER
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_USER
  WAITING_VENDOR
  RESOLVED
  CLOSED
  DERIVED_TO_IMPROVEMENT
  DERIVED_TO_INTEGRATION
}

enum Channel {
  WEB
  EMAIL
  CHATBOT
  SYSTEM
}

enum Visibility {
  PUBLIC
  INTERNAL
}

model Ticket {
  id                    String         @id @default(uuid()) @db.Uuid
  // Se muestra como TLI-000123.
  number                Int            @unique @default(autoincrement())
  type                  TicketType
  category              TicketCategory
  subject               String
  description           String
  requesterId           String         @db.Uuid
  assigneeId            String?        @db.Uuid
  warehouseId           String?        @db.Uuid
  areaId                String?        @db.Uuid
  userUrgency           Priority
  priority              Priority
  // true mientras la prioridad sea la urgencia indicada por el usuario (IT todavía no la fijó).
  priorityIsProvisional Boolean        @default(true)
  status                TicketStatus   @default(NEW)
  channel               Channel        @default(WEB)
  // Respuestas específicas del tipo de ticket (validadas con zod en @tli/shared).
  extraFields           Json           @default("{}")

  // SLA (ADR 0007). Los vencimientos se recalculan al cambiar prioridad o al reanudar una pausa.
  firstResponseDueAt    DateTime
  resolutionDueAt       DateTime?
  firstRespondedAt      DateTime?
  slaPausedAt           DateTime?
  slaPausedMinutes      Int       @default(0)
  firstResponseRiskAt   DateTime?
  firstResponseBreachAt DateTime?
  resolutionRiskAt      DateTime?
  resolutionBreachAt    DateTime?

  resolvedAt         DateTime?
  closedAt           DateTime?
  closeReason        String?
  resolutionCause    String?
  resolutionSolution String?
  problemId          String?                  @db.Uuid
  // Columna generada (ver migración problems): asunto + descripción, en español sin acentos.
  searchVector       Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('tli_spanish'::regconfig, COALESCE(subject, ''::text)), 'A'::\"char\") || setweight(to_tsvector('tli_spanish'::regconfig, COALESCE(description, ''::text)), 'B'::\"char\"))"))
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  requester   User            @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee    User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  warehouse   Warehouse?      @relation(fields: [warehouseId], references: [id])
  area        Area?           @relation(fields: [areaId], references: [id])
  comments    TicketComment[]
  timeEntries TimeEntry[]
  attachments Attachment[]
  problem     Problem?        @relation(fields: [problemId], references: [id], onDelete: SetNull)

  @@index([status, assigneeId])
  @@index([requesterId, createdAt])
  @@index([firstResponseDueAt])
  @@index([resolutionDueAt])
  @@index([problemId])
  @@index([searchVector], type: Gin)
  @@index([subject(ops: raw("gin_trgm_ops"))], type: Gin, map: "Ticket_subject_trgm_idx")
}

model TicketComment {
  id          String       @id @default(uuid()) @db.Uuid
  ticketId    String       @db.Uuid
  authorId    String       @db.Uuid
  body        String
  visibility  Visibility   @default(PUBLIC)
  source      Channel      @default(WEB)
  createdAt   DateTime     @default(now())
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  attachments Attachment[]

  @@index([ticketId, createdAt])
}

model TimeEntry {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  userId    String   @db.Uuid
  minutes   Int
  workDate  DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId, workDate])
}

// Historial funcional de cualquier entidad (lo que se ve en el detalle). La auditoría es aparte.
model ActivityEvent {
  id         String     @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String     @db.Uuid
  actorId    String?    @db.Uuid
  kind       String
  field      String?
  oldValue   String?
  newValue   String?
  // PUBLIC: lo ve también el solicitante (ej. cambios de estado).
  visibility Visibility @default(INTERNAL)
  occurredAt DateTime   @default(now())
  actor      User?      @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, occurredAt])
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  kind       String
  title      String
  body       String?
  link       String?
  entityType String?
  entityId   String?   @db.Uuid
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// Configuración clave/valor (SLA, horario hábil, cierre automático, mail).
model Setting {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
}

model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Fase 2b: adjuntos (ADR 0006)
// ---------------------------------------------------------------------------

enum ScanStatus {
  PENDING_SCAN
  CLEAN
  INFECTED
}

// Un adjunto se sube antes de crear el ticket o el comentario y después se vincula.
// Los no vinculados se borran a las 24 h. Cada módulo que acepte adjuntos suma su FK.
model Attachment {
  id           String     @id @default(uuid()) @db.Uuid
  // Ruta relativa dentro del almacenamiento: quarantine/<id> o clean/<id>.
  storageKey   String     @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  scanStatus   ScanStatus @default(PENDING_SCAN)
  scanDetail   String?
  uploadedById String     @db.Uuid
  ticketId     String?    @db.Uuid
  commentId    String?    @db.Uuid
  createdAt    DateTime   @default(now())
  scannedAt    DateTime?

  uploadedBy User           @relation(fields: [uploadedById], references: [id])
  ticket     Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment    TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([commentId])
  @@index([uploadedById, createdAt])
}

// ---------------------------------------------------------------------------
// Fase 3: problemas (causa raíz)
// ---------------------------------------------------------------------------

enum ProblemStatus {
  OPEN
  INVESTIGATING
  ROOT_CAUSE_IDENTIFIED
  RESOLVED
}

// Agrupa tickets que comparten causa raíz (práctica ITIL de problem management).
model Problem {
  id                String                   @id @default(uuid()) @db.Uuid
  // Se muestra como PRB-0001.
  number            Int                      @unique @default(autoincrement())
  title             String
  description       String
  category          TicketCategory
  rootCause         String?
  workaround        String?
  permanentSolution String?
  status            ProblemStatus            @default(OPEN)
  ownerId           String?                  @db.Uuid
  createdById       String                   @db.Uuid
  resolvedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  // Columna generada: título + descripción + causa raíz.
  searchVector      Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('tli_spanish'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('tli_spanish'::regconfig, COALESCE(description, ''::text)), 'B'::\"char\")) || setweight(to_tsvector('tli_spanish'::regconfig, COALESCE(\"rootCause\", ''::text)), 'C'::\"char\"))"))

  owner     User?    @relation("ProblemOwner", fields: [ownerId], references: [id])
  createdBy User     @relation("ProblemCreator", fields: [createdById], references: [id])
  tickets   Ticket[]

  @@index([status])
  @@index([searchVector], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Problem_title_trgm_idx")
}
