// Schema de datos del Sistema de Gestión TLI. Ver docs/data-model.md.
// Fase 1: identidad, sesiones, RBAC, auditoría y catálogos.
// Fase 2: tickets, comentarios, tiempo, actividad, notificaciones y configuración de SLA.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  // Se guarda siempre en minúsculas.
  email               String     @unique
  fullName            String
  passwordHash        String
  mustChangePassword  Boolean    @default(true)
  passwordChangedAt   DateTime?
  status              UserStatus @default(ACTIVE)
  defaultAreaId       String?    @db.Uuid
  defaultWarehouseId  String?    @db.Uuid
  // Secretos TOTP cifrados con AES-256-GCM (MFA_ENCRYPTION_KEY).
  mfaSecretEnc        String?
  mfaPendingSecretEnc String?
  mfaEnabledAt        DateTime?
  // Último time-step TOTP aceptado: impide reutilizar un código (ASVS 2.8.4).
  mfaLastUsedStep     Int?
  failedLoginCount    Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  anonymizedAt        DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  defaultArea          Area?                 @relation(fields: [defaultAreaId], references: [id])
  defaultWarehouse     Warehouse?            @relation(fields: [defaultWarehouseId], references: [id])
  roles                UserRole[]
  sessions             Session[]
  recoveryCodes        MfaRecoveryCode[]
  auditEntries         AuditLog[]
  requestedTickets     Ticket[]              @relation("TicketRequester")
  assignedTickets      Ticket[]              @relation("TicketAssignee")
  ticketComments       TicketComment[]
  timeEntries          TimeEntry[]
  notifications        Notification[]
  activityEvents       ActivityEvent[]
  attachments          Attachment[]
  ownedProblems        Problem[]             @relation("ProblemOwner")
  createdProblems      Problem[]             @relation("ProblemCreator")
  ownedImprovements    Improvement[]         @relation("ImprovementOwner")
  createdImprovements  Improvement[]         @relation("ImprovementCreator")
  improvementComments  ImprovementComment[]
  problemActions       ProblemAction[]
  ownedIntegrations    Integration[]         @relation("IntegrationOwner")
  createdIntegrations  Integration[]         @relation("IntegrationCreator")
  integrationActions   IntegrationAction[]
  integrationRevisions IntegrationRevision[]
  integrationQuotes    IntegrationQuote[]
  documents            Document[]
  documentVersions     DocumentVersion[]
  articles             Article[]
  articleVersions      ArticleVersion[]

  @@index([status])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  description String           @default("")
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  // Clave estable, ej. "ticket.manage". Se siembra desde @tli/shared.
  key         String           @id
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId        String     @db.Uuid
  permissionKey String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  // SHA-256 del token opaco que viaja en la cookie.
  tokenHash     String    @unique
  userId        String    @db.Uuid
  mfaVerified   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  idleExpiresAt DateTime
  expiresAt     DateTime
  revokedAt     DateTime?
  ip            String?
  userAgent     String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Append-only: un trigger impide UPDATE/DELETE/TRUNCATE. Ver ADR 0008.
model AuditLog {
  seq        BigInt   @id @default(autoincrement())
  occurredAt DateTime @default(now())
  actorId    String?  @db.Uuid
  action     String
  entityType String?
  entityId   String?
  ip         String?
  metadata   Json     @default("{}")
  prevHash   String
  hash       String
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
}

model Area {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @unique
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  tickets      Ticket[]
  improvements Improvement[]
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  tickets   Ticket[]
  clients   Client[]
}

model Provider {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @unique
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  improvements Improvement[]
  quotes       IntegrationQuote[]
}

// ---------------------------------------------------------------------------
// Fase 2: ticketera
// ---------------------------------------------------------------------------

enum TicketType {
  SUPPORT
  AUTOMATION
  INTEGRATION
  ACCESS
}

// ACCESS queda solo por tickets históricos: los accesos ahora son un tipo de ticket.
enum TicketCategory {
  WMS
  TMS
  TYT
  ROUTING
  INTEGRATION
  ACCESS
  HARDWARE
  NETWORK
  OTHER
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_USER
  WAITING_VENDOR
  RESOLVED
  CLOSED
  DERIVED_TO_IMPROVEMENT
  DERIVED_TO_INTEGRATION
}

enum Channel {
  WEB
  EMAIL
  CHATBOT
  SYSTEM
}

enum Visibility {
  PUBLIC
  INTERNAL
}

model Ticket {
  id                    String         @id @default(uuid()) @db.Uuid
  // Se muestra como TLI-000123.
  number                Int            @unique @default(autoincrement())
  type                  TicketType
  category              TicketCategory
  subject               String
  description           String
  requesterId           String         @db.Uuid
  assigneeId            String?        @db.Uuid
  warehouseId           String?        @db.Uuid
  areaId                String?        @db.Uuid
  userUrgency           Priority
  priority              Priority
  // true mientras la prioridad sea la urgencia indicada por el usuario (IT todavía no la fijó).
  priorityIsProvisional Boolean        @default(true)
  status                TicketStatus   @default(NEW)
  channel               Channel        @default(WEB)
  // Respuestas específicas del tipo de ticket (validadas con zod en @tli/shared).
  extraFields           Json           @default("{}")

  // SLA (ADR 0007). Los vencimientos se recalculan al cambiar prioridad o al reanudar una pausa.
  firstResponseDueAt    DateTime
  resolutionDueAt       DateTime?
  firstRespondedAt      DateTime?
  slaPausedAt           DateTime?
  slaPausedMinutes      Int       @default(0)
  firstResponseRiskAt   DateTime?
  firstResponseBreachAt DateTime?
  resolutionRiskAt      DateTime?
  resolutionBreachAt    DateTime?

  resolvedAt         DateTime?
  closedAt           DateTime?
  closeReason        String?
  resolutionCause    String?
  resolutionSolution String?
  problemId          String?                  @db.Uuid
  // Mejora a la que se derivó (estado DERIVED_TO_IMPROVEMENT). Se cierra cuando la mejora termina.
  improvementId      String?                  @db.Uuid
  // Integración a la que se derivó (estado DERIVED_TO_INTEGRATION).
  integrationId      String?                  @db.Uuid
  // Columna generada (ver migración problems): asunto + descripción, en español sin acentos.
  searchVector       Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('tli_spanish'::regconfig, COALESCE(subject, ''::text)), 'A'::\"char\") || setweight(to_tsvector('tli_spanish'::regconfig, COALESCE(description, ''::text)), 'B'::\"char\"))"))
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  requester   User            @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee    User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  warehouse   Warehouse?      @relation(fields: [warehouseId], references: [id])
  area        Area?           @relation(fields: [areaId], references: [id])
  comments    TicketComment[]
  timeEntries TimeEntry[]
  attachments Attachment[]
  problem     Problem?        @relation(fields: [problemId], references: [id], onDelete: SetNull)
  improvement Improvement?    @relation(fields: [improvementId], references: [id], onDelete: SetNull)
  integration Integration?    @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  articles    Article[]

  @@index([status, assigneeId])
  @@index([requesterId, createdAt])
  @@index([firstResponseDueAt])
  @@index([resolutionDueAt])
  @@index([problemId])
  @@index([improvementId])
  @@index([integrationId])
  @@index([searchVector], type: Gin)
  @@index([subject(ops: raw("gin_trgm_ops"))], type: Gin, map: "Ticket_subject_trgm_idx")
}

model TicketComment {
  id          String       @id @default(uuid()) @db.Uuid
  ticketId    String       @db.Uuid
  authorId    String       @db.Uuid
  body        String
  visibility  Visibility   @default(PUBLIC)
  source      Channel      @default(WEB)
  createdAt   DateTime     @default(now())
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  attachments Attachment[]

  @@index([ticketId, createdAt])
}

model TimeEntry {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  userId    String   @db.Uuid
  minutes   Int
  workDate  DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId, workDate])
}

// Historial funcional de cualquier entidad (lo que se ve en el detalle). La auditoría es aparte.
model ActivityEvent {
  id         String     @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String     @db.Uuid
  actorId    String?    @db.Uuid
  kind       String
  field      String?
  oldValue   String?
  newValue   String?
  // PUBLIC: lo ve también el solicitante (ej. cambios de estado).
  visibility Visibility @default(INTERNAL)
  occurredAt DateTime   @default(now())
  actor      User?      @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, occurredAt])
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  kind       String
  title      String
  body       String?
  link       String?
  entityType String?
  entityId   String?   @db.Uuid
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// Configuración clave/valor (SLA, horario hábil, cierre automático, mail).
model Setting {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
}

model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Fase 2b: adjuntos (ADR 0006)
// ---------------------------------------------------------------------------

enum ScanStatus {
  PENDING_SCAN
  CLEAN
  INFECTED
}

// Un adjunto se sube antes de crear el ticket o el comentario y después se vincula.
// Los no vinculados se borran a las 24 h. Cada módulo que acepte adjuntos suma su FK.
model Attachment {
  id                   String     @id @default(uuid()) @db.Uuid
  // Ruta relativa dentro del almacenamiento: quarantine/<id> o clean/<id>.
  storageKey           String     @unique
  originalName         String
  mimeType             String
  sizeBytes            Int
  sha256               String
  scanStatus           ScanStatus @default(PENDING_SCAN)
  scanDetail           String?
  uploadedById         String     @db.Uuid
  ticketId             String?    @db.Uuid
  commentId            String?    @db.Uuid
  // Adjuntos de las acciones registradas en una mejora o en un problema.
  improvementCommentId String?    @db.Uuid
  problemActionId      String?    @db.Uuid
  integrationActionId  String?    @db.Uuid
  integrationQuoteId   String?    @db.Uuid
  // Archivo de una versión de documento de la biblioteca.
  documentVersionId    String?    @unique @db.Uuid
  createdAt            DateTime   @default(now())
  scannedAt            DateTime?

  uploadedBy         User                @relation(fields: [uploadedById], references: [id])
  ticket             Ticket?             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment            TicketComment?      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  improvementComment ImprovementComment? @relation(fields: [improvementCommentId], references: [id], onDelete: Cascade)
  problemAction      ProblemAction?      @relation(fields: [problemActionId], references: [id], onDelete: Cascade)
  integrationAction  IntegrationAction?  @relation(fields: [integrationActionId], references: [id], onDelete: Cascade)
  integrationQuote   IntegrationQuote?   @relation(fields: [integrationQuoteId], references: [id], onDelete: Cascade)
  documentVersion    DocumentVersion?    @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([commentId])
  @@index([improvementCommentId])
  @@index([problemActionId])
  @@index([integrationActionId])
  @@index([integrationQuoteId])
  @@index([uploadedById, createdAt])
}

// ---------------------------------------------------------------------------
// Fase 3: problemas (causa raíz)
// ---------------------------------------------------------------------------

enum ProblemStatus {
  OPEN
  INVESTIGATING
  ROOT_CAUSE_IDENTIFIED
  RESOLVED
}

// Agrupa tickets que comparten causa raíz (práctica ITIL de problem management).
model Problem {
  id                String                   @id @default(uuid()) @db.Uuid
  // Se muestra como PRB-0001.
  number            Int                      @unique @default(autoincrement())
  title             String
  description       String
  category          TicketCategory
  rootCause         String?
  workaround        String?
  permanentSolution String?
  status            ProblemStatus            @default(OPEN)
  ownerId           String?                  @db.Uuid
  createdById       String                   @db.Uuid
  resolvedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  // Columna generada: título + descripción + causa raíz.
  searchVector      Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('tli_spanish'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('tli_spanish'::regconfig, COALESCE(description, ''::text)), 'B'::\"char\")) || setweight(to_tsvector('tli_spanish'::regconfig, COALESCE(\"rootCause\", ''::text)), 'C'::\"char\"))"))

  owner        User?           @relation("ProblemOwner", fields: [ownerId], references: [id])
  createdBy    User            @relation("ProblemCreator", fields: [createdById], references: [id])
  tickets      Ticket[]
  improvements Improvement[]
  actions      ProblemAction[]
  articles     Article[]

  @@index([status])
  @@index([searchVector], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Problem_title_trgm_idx")
}

// ---------------------------------------------------------------------------
// Fase 4: mejoras WMS/TMS
// ---------------------------------------------------------------------------

enum ImprovementStatus {
  IDEA
  ANALYSIS
  APPROVED
  IN_DEVELOPMENT
  TESTING
  IMPLEMENTED
  DISCARDED
}

enum ImprovementSystem {
  WMS
  TMS
  TYT
  ROUTING
  OTHER
}

enum Currency {
  ARS
  USD
}

model Improvement {
  id               String            @id @default(uuid()) @db.Uuid
  // Se muestra como MEJ-0001.
  number           Int               @unique @default(autoincrement())
  title            String
  system           ImprovementSystem
  requestingAreaId String?           @db.Uuid
  currentSituation String
  proposal         String
  expectedImpact   String?
  // 1 bajo · 2 medio · 3 alto. La prioridad se deriva de impacto y esfuerzo salvo que IT la fije.
  impact           Int               @default(2)
  effort           Int               @default(2)
  priority         Priority          @default(MEDIUM)
  priorityIsManual Boolean           @default(false)
  ownerId          String?           @db.Uuid
  providerId       String?           @db.Uuid
  currency         Currency          @default(ARS)
  estimatedCost    Decimal?          @db.Decimal(14, 2)
  actualCost       Decimal?          @db.Decimal(14, 2)
  estimatedHours   Decimal?          @db.Decimal(8, 1)
  actualHours      Decimal?          @db.Decimal(8, 1)
  startDate        DateTime?         @db.Date
  targetDate       DateTime?         @db.Date
  completedAt      DateTime?
  status           ImprovementStatus @default(IDEA)
  // Obligatorio al implementar o descartar: se publica en los tickets derivados al cerrarlos.
  closingMessage   String?
  createdById      String            @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  requestingArea Area?                @relation(fields: [requestingAreaId], references: [id])
  owner          User?                @relation("ImprovementOwner", fields: [ownerId], references: [id])
  provider       Provider?            @relation(fields: [providerId], references: [id])
  createdBy      User                 @relation("ImprovementCreator", fields: [createdById], references: [id])
  tickets        Ticket[]
  problems       Problem[]
  clients        Client[]
  comments       ImprovementComment[]

  @@index([status])
  @@index([system, status])
}

// Acciones y avances que registra IT (con adjuntos). Siempre internos: el solicitante solo ve
// el mensaje de cierre.
model ImprovementComment {
  id            String       @id @default(uuid()) @db.Uuid
  improvementId String       @db.Uuid
  authorId      String       @db.Uuid
  body          String
  createdAt     DateTime     @default(now())
  improvement   Improvement  @relation(fields: [improvementId], references: [id], onDelete: Cascade)
  author        User         @relation(fields: [authorId], references: [id])
  attachments   Attachment[]

  @@index([improvementId, createdAt])
}

// Acciones tomadas sobre un problema (diagnóstico, pruebas, cambios), con adjuntos. Internas.
model ProblemAction {
  id          String       @id @default(uuid()) @db.Uuid
  problemId   String       @db.Uuid
  authorId    String       @db.Uuid
  body        String
  createdAt   DateTime     @default(now())
  problem     Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  attachments Attachment[]

  @@index([problemId, createdAt])
}

// ---------------------------------------------------------------------------
// Fase 5: clientes, integraciones y biblioteca básica
// ---------------------------------------------------------------------------

enum ClientStatus {
  ACTIVE
  ONBOARDING
  INACTIVE
}

enum ContactKind {
  COMMERCIAL
  SYSTEMS
  OTHER
}

model Client {
  id        String       @id @default(uuid()) @db.Uuid
  legalName String
  shortName String?
  // CUIT sin guiones (11 dígitos, dígito verificador validado). Puede faltar en un alta en curso.
  cuit      String?      @unique
  status    ClientStatus @default(ACTIVE)
  // Domicilio fiscal o comercial (del F50: domicilio, localidad, CP y provincia).
  address   String?
  // Folio del formulario F50 de alta de clientes: permite reimportar sin duplicar.
  f50Folio  String?      @unique
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  warehouses   Warehouse[]
  contacts     ClientContact[]
  integrations Integration[]
  improvements Improvement[]

  @@index([legalName])
}

model ClientContact {
  id        String      @id @default(uuid()) @db.Uuid
  clientId  String      @db.Uuid
  kind      ContactKind @default(OTHER)
  // Área del cliente que atiende (Operaciones, Facturación, Tráfico…).
  role      String?
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime    @default(now())
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

enum IntegrationCounterpart {
  CLIENT
  CARRIER
  OTHER
}

enum IntegrationProcess {
  INBOUND_ORDERS
  OUTBOUND_ORDERS
  STOCK
  DELIVERY_NOTES
  CONFIRMATIONS
  TRACKING
  LABELS
  OTHER
}

enum IntegrationSystem {
  WMS
  TMS
  TYT
  ROUTING
}

enum IntegrationDirection {
  INBOUND
  OUTBOUND
  BIDIRECTIONAL
}

enum IntegrationChannel {
  FTP_SFTP
  NETWORK_FOLDER
  EMAIL
  API
  EDI
  MANUAL
}

enum IntegrationFormat {
  CSV
  FIXED_WIDTH_TXT
  XML
  JSON
  EXCEL
}

enum IntegrationStatus {
  PENDING_SURVEY
  PENDING_QUOTE
  QUOTED
  IN_DEVELOPMENT
  COMPLETED
  NOT_DONE
}

enum NotDoneReason {
  CLIENT_REJECTED_COST
  TML_REJECTED_COST
  OTHER
}

model Integration {
  id                  String                 @id @default(uuid()) @db.Uuid
  // Se muestra como INT-0001.
  number              Int                    @unique @default(autoincrement())
  name                String
  // Con quién: un cliente del maestro, un expreso u otro (estos dos por nombre).
  counterpartType     IntegrationCounterpart
  clientId            String?                @db.Uuid
  counterpartName     String?
  // Una integración puede cubrir varios procesos y tocar varios sistemas nuestros.
  processes           IntegrationProcess[]
  systems             IntegrationSystem[]
  // null mientras no se sepa (el pedido puede venir con "No sé").
  direction           IntegrationDirection?
  channel             IntegrationChannel?
  format              IntegrationFormat?
  frequency           String?
  // Carpeta, endpoint o casilla.
  location            String?
  requiresDevelopment Boolean                @default(true)
  status              IntegrationStatus      @default(PENDING_SURVEY)
  notDoneReason       NotDoneReason?
  notDoneNotes        String?
  // Texto con plantilla (Flujo, Origen y destino, …). Cada cambio queda en IntegrationRevision.
  howItWorks          String                 @default("")
  currency            Currency               @default(ARS)
  estimatedHours      Decimal?               @db.Decimal(8, 1)
  actualHours         Decimal?               @db.Decimal(8, 1)
  actualCost          Decimal?               @db.Decimal(14, 2)
  startDate           DateTime?              @db.Date
  targetDate          DateTime?              @db.Date
  goLiveDate          DateTime?              @db.Date
  ownerId             String?                @db.Uuid
  // Mensaje para los tickets derivados al finalizar o no realizarse.
  closingMessage      String?
  completedAt         DateTime?
  createdById         String                 @db.Uuid
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  client        Client?               @relation(fields: [clientId], references: [id])
  // Plataformas del otro lado: e-commerce (MELI, Tienda Nube…) o ERP (SAP, Odoo…).
  platforms     Platform[]
  owner         User?                 @relation("IntegrationOwner", fields: [ownerId], references: [id])
  createdBy     User                  @relation("IntegrationCreator", fields: [createdById], references: [id])
  tickets       Ticket[]
  revisions     IntegrationRevision[]
  quotes        IntegrationQuote[]
  actions       IntegrationAction[]
  contentChunks ContentChunk[]

  @@index([status])
  @@index([clientId])
}

model IntegrationRevision {
  id            String      @id @default(uuid()) @db.Uuid
  integrationId String      @db.Uuid
  howItWorks    String
  authorId      String      @db.Uuid
  createdAt     DateTime    @default(now())
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  author        User        @relation(fields: [authorId], references: [id])

  @@index([integrationId, createdAt])
}

model IntegrationQuote {
  id             String       @id @default(uuid()) @db.Uuid
  integrationId  String       @db.Uuid
  providerId     String       @db.Uuid
  amount         Decimal      @db.Decimal(14, 2)
  currency       Currency     @default(ARS)
  estimatedHours Decimal?     @db.Decimal(8, 1)
  quotedAt       DateTime     @db.Date
  notes          String?
  // Una sola elegida por integración: define el costo estimado.
  isSelected     Boolean      @default(false)
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  integration    Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  provider       Provider     @relation(fields: [providerId], references: [id])
  createdBy      User         @relation(fields: [createdById], references: [id])
  attachments    Attachment[]

  @@index([integrationId])
}

model IntegrationAction {
  id            String       @id @default(uuid()) @db.Uuid
  integrationId String       @db.Uuid
  authorId      String       @db.Uuid
  body          String
  createdAt     DateTime     @default(now())
  integration   Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  author        User         @relation(fields: [authorId], references: [id])
  attachments   Attachment[]

  @@index([integrationId, createdAt])
}

enum DocumentVisibility {
  PUBLIC
  INTERNAL
}

enum DocumentEntity {
  CLIENT
  INTEGRATION
  IMPROVEMENT
  ARTICLE
}

enum DocumentLinkType {
  SPECIFICATION
  LAYOUT
  SAMPLE_FILE
  MINUTES
  QUOTE
  MANUAL
  OTHER
}

// Biblioteca: un documento tiene versiones (cada una, un archivo) y se vincula a entidades.
// La extracción de texto, OCR y búsqueda llegan en la Fase 6.
model Document {
  id               String             @id @default(uuid()) @db.Uuid
  title            String
  description      String?
  visibility       DocumentVisibility @default(INTERNAL)
  category         KnowledgeCategory  @default(OTHER)
  // Sistema al que aplica (WMS, TMS…); null = general.
  system           String?
  tags             String[]           @default([])
  currentVersionId String?            @unique @db.Uuid
  authorId         String             @db.Uuid
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  author         User              @relation(fields: [authorId], references: [id])
  currentVersion DocumentVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions       DocumentVersion[] @relation("DocumentVersions")
  links          DocumentLink[]
}

model DocumentVersion {
  id               String           @id @default(uuid()) @db.Uuid
  documentId       String           @db.Uuid
  version          Int
  note             String?
  // Extracción de texto (worker): PENDING hasta que el antivirus libera el archivo.
  extractionStatus ExtractionStatus @default(PENDING)
  extractionDetail String?
  ocrUsed          Boolean          @default(false)
  // Páginas escaneadas que no se pudieron leer porque no hay OCR instalado.
  pagesWithoutText Int              @default(0)
  pageCount        Int?
  uploadedById     String           @db.Uuid
  createdAt        DateTime         @default(now())
  chunks           ContentChunk[]
  document         Document         @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy       User             @relation(fields: [uploadedById], references: [id])
  attachment       Attachment?
  currentOf        Document?        @relation("CurrentVersion")

  @@unique([documentId, version])
}

model DocumentLink {
  id         String           @id @default(uuid()) @db.Uuid
  documentId String           @db.Uuid
  entityType DocumentEntity
  entityId   String           @db.Uuid
  linkType   DocumentLinkType @default(OTHER)
  createdAt  DateTime         @default(now())
  document   Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, entityType, entityId])
  @@index([entityType, entityId])
}

enum PlatformCategory {
  ECOMMERCE
  ERP
  OTHER
}

// Catálogo editable de plataformas externas con las que nos integramos.
model Platform {
  id           String           @id @default(uuid()) @db.Uuid
  name         String           @unique
  category     PlatformCategory @default(OTHER)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  integrations Integration[]
}

// ---------------------------------------------------------------------------
// Fase 6: base de conocimiento
// ---------------------------------------------------------------------------

enum KnowledgeCategory {
  WMS
  TMS
  INTEGRATIONS
  PROCEDURES
  FREQUENT_ERRORS
  OTHER
}

enum ArticleTemplate {
  FREE
  ERROR_SHEET
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExtractionStatus {
  PENDING
  DONE
  FAILED
  SKIPPED
}

enum ChunkSource {
  ARTICLE
  DOCUMENT
  INTEGRATION
}

model Article {
  id               String             @id @default(uuid()) @db.Uuid
  // Se muestra como KB-0001.
  number           Int                @unique @default(autoincrement())
  category         KnowledgeCategory
  template         ArticleTemplate    @default(FREE)
  // PUBLIC: lo ven todos los usuarios (una vez publicado). INTERNAL: solo IT.
  visibility       DocumentVisibility @default(INTERNAL)
  status           ArticleStatus      @default(DRAFT)
  tags             String[]           @default([])
  currentVersionId String?            @unique @db.Uuid
  sourceTicketId   String?            @db.Uuid
  sourceProblemId  String?            @db.Uuid
  authorId         String             @db.Uuid
  publishedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  author         User             @relation(fields: [authorId], references: [id])
  currentVersion ArticleVersion?  @relation("ArticleCurrentVersion", fields: [currentVersionId], references: [id])
  versions       ArticleVersion[] @relation("ArticleVersions")
  sourceTicket   Ticket?          @relation(fields: [sourceTicketId], references: [id], onDelete: SetNull)
  sourceProblem  Problem?         @relation(fields: [sourceProblemId], references: [id], onDelete: SetNull)

  @@index([status, visibility])
}

// Cada guardado es una versión: el artículo apunta a la vigente y el historial queda completo.
model ArticleVersion {
  id            String         @id @default(uuid()) @db.Uuid
  articleId     String         @db.Uuid
  version       Int
  title         String
  // HTML sanitizado en el servidor (ADR 0009).
  body          String         @default("")
  // Ficha de error: síntoma, causa, solución y pasos.
  errorSymptom  String?
  errorCause    String?
  errorSolution String?
  errorSteps    String?
  authorId      String         @db.Uuid
  createdAt     DateTime       @default(now())
  article       Article        @relation("ArticleVersions", fields: [articleId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id])
  currentOf     Article?       @relation("ArticleCurrentVersion")
  chunks        ContentChunk[]

  @@unique([articleId, version])
}

// Fragmentos de texto para búsqueda (y a futuro, IA: ADR 0011). Se reemplazan completos por
// versión. Un fragmento nunca cruza páginas, para poder citar la página.
model ContentChunk {
  id                String                   @id @default(uuid()) @db.Uuid
  sourceType        ChunkSource
  articleVersionId  String?                  @db.Uuid
  documentVersionId String?                  @db.Uuid
  integrationId     String?                  @db.Uuid
  pageNumber        Int?
  ordinal           Int
  text              String
  visibility        DocumentVisibility
  contentHash       String
  tokenCount        Int
  searchVector      Unsupported("tsvector")? @default(dbgenerated("to_tsvector('tli_spanish'::regconfig, text)"))
  createdAt         DateTime                 @default(now())

  articleVersion  ArticleVersion?  @relation(fields: [articleVersionId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  integration     Integration?     @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([searchVector], type: Gin)
  @@index([articleVersionId])
  @@index([documentVersionId])
  @@index([integrationId])
}
