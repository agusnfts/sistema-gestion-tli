{
  "name": "@tli/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:api": "nest start --watch",
    "dev:worker": "nest start --watch --path tsconfig.worker.json --entryFile worker.main",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@tli/db": "workspace:*",
    "@tli/shared": "workspace:*",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "mammoth": "1.13.0",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "^10.2.1",
    "otplib": "^12.0.1",
    "pdfjs-dist": "6.4.299",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "read-excel-file": "9.3.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "2.18.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.13.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "unplugin-swc": "^1.5.7",
    "vitest": "^4.1.12"
  }
}
