# Copiar a .env (pnpm dev lo hace solo la primera vez y genera MFA_ENCRYPTION_KEY).
# Nunca commitear .env.

# --- Base de datos ---
# Conexión de la aplicación (rol con mínimo privilegio, solo DML).
DATABASE_URL=postgresql://tli_app:tli_app_dev@localhost:5432/tli?schema=public
# Conexión para migraciones (owner del schema).
DATABASE_MIGRATION_URL=postgresql://tli:tli_dev@localhost:5432/tli?schema=public
# Opcional: base separada para `pnpm test:e2e` (si no se define, usa DATABASE_URL).
# TEST_DATABASE_URL=postgresql://tli_app:tli_app_dev@localhost:5432/tli_test?schema=public

# --- API ---
API_PORT=3000
LOG_LEVEL=info
# Origen público de la web (se valida en requests que modifican estado).
APP_ORIGIN=http://localhost:5173
# true en producción (HTTPS). Con true la cookie usa el prefijo __Host-.
COOKIE_SECURE=false
# Detrás de un reverse proxy (Caddy) poner 1 para tomar la IP real.
TRUST_PROXY=0

# --- Sesiones (minutos) ---
# Roles con MFA (Admin, IT)
SESSION_IDLE_MINUTES_PRIVILEGED=30
SESSION_ABSOLUTE_MINUTES_PRIVILEGED=720
# Usuarios
SESSION_IDLE_MINUTES_STANDARD=480
SESSION_ABSOLUTE_MINUTES_STANDARD=10080

# --- MFA ---
# Clave AES-256 en base64 (32 bytes) para cifrar secretos TOTP.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Sistema de Gestión TLI
