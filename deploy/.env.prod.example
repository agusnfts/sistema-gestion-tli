# Variables de producción. Copiar a deploy/.env en el servidor y completar.
# NUNCA commitear el .env real. Permisos: chmod 600 .env
# Generar secretos con:  openssl rand -base64 32

# --- Dominio (Caddy saca el certificado de Let's Encrypt) ---
DOMAIN=tli.ejemplo.com.ar
ACME_EMAIL=sistemas@tml.com.ar

# --- Base de datos ---
# Owner del schema: solo lo usan las migraciones y los backups.
OWNER_DB_PASSWORD=
# Rol de la aplicación (solo DML). Se crea al inicializar la base.
APP_DB_PASSWORD=

# --- MFA ---
# Clave AES-256 (32 bytes en base64). Si se pierde, todos tienen que volver a configurar MFA.
# Guardar una copia en el gestor de contraseñas del área.
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Sistema de Gestión TLI

# --- Backups cifrados ---
# Clave PÚBLICA de age (age1...). La privada se guarda FUERA del servidor (gestor de
# contraseñas / sobre en caja fuerte): sin ella no se puede restaurar.
BACKUP_AGE_RECIPIENT=
BACKUP_KEEP_DAYS=14
# Carpeta del host donde quedan los archivos cifrados (después se copian afuera del VPS).
BACKUP_DIR=/var/backups/tli

# --- Mail saliente (opcional; el sistema funciona sin mail) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sistema de Gestión TLI <no-responder@tml.com.ar>
